# Leave these empty for local browser-only development.
# Set them for the Telegram bot and production Mini App authentication.
TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_ID=

# Claude API key — get from https://console.anthropic.com
ANTHROPIC_API_KEY=

# URL where the frontend Mini App is hosted
MINI_APP_URL=

# PostgreSQL connection string
DATABASE_URL=postgresql://miles:miles_dev@localhost:5432/miles_tracker

# Backend server port
PORT=3000
HOST=127.0.0.1

# Environment
NODE_ENV=development
